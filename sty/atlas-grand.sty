% atlas-grand.sty: the grand edition. Loads atlas.sty and lays every costume
% device the lab has over a running manuscript, at once, to see where the
% limit is. Load it in place of atlas (it loads atlas itself), last in the
% preamble; name the theorem environments with \AtlasProposition etc. as for
% atlas; add \AtEndDocument{\AtlasColophon} for the colophon leaf.
%
% Over atlas it sets: the rubric red, so every head, rule and running head
% that atlas sets in the rubric token turns (01); 02's broad outer margin,
% with the propositions' names glossed in it instead of set beneath their
% heads; a dropped three-line initial at the first paragraph after every
% section head (01); a title leaf of its own, framed with corner pieces
% (05), carrying the Argument, atlas's Table of the Propositions (07, with
% real pages), fleurons and the imprint; roman section numerals; a fleuron
% before every section; the hand press (06): baseline scatter and ink squash
% on text lines, laid paper and foxing beneath every page; and ornaments and
% a sentence on the sheet for atlas's colophon. Three passes: the Table.
%
% Options: plain and rareligatures pass through to atlas. Nothing here is
% meant for a preprint one would post; that is what atlas is for.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atlas-grand}[2026/09/16 latex-atlas: the grand edition]

\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{atlas}}
\ProcessOptions\relax
\RequirePackage{atlas}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{pgfornament}
\RequirePackage{lettrine}
\RequirePackage{needspace}
\RequirePackage{luacode}

% --- the second colour ---------------------------------------------------------
% atlas sets rubric equal to ink; here it is red, and everything follows.
\ifatlas@plain
  \definecolor{rubric}{HTML}{000000}
  \definecolor{glossink}{HTML}{000000}
  \definecolor{foxing}{HTML}{FFFFFF}
\else
  \definecolor{rubric}{HTML}{9E2B25}
  \definecolor{glossink}{HTML}{5A4A3A}
  \definecolor{foxing}{HTML}{8A5A2B}
\fi

% --- the page: 02's broad outer margin, twoside ----------------------------------
\geometry{a4paper,twoside,top=30mm,bottom=32mm,inner=26mm,outer=54mm,
  marginparwidth=36mm,marginparsep=6mm,headheight=14pt,headsep=8mm}

% --- heads: the note goes to the margin as a gloss (02); numerals roman ---------------
\RenewDocumentCommand{\atlas@head}{o m}{%
  \par\addvspace{1.1em plus .3em}%
  \centerline{\small\textcolor{rubric}{\textls[120]{\textsc{#2}}}}%
  \IfValueT{#1}{\marginpar{\footnotesize\raggedright\itshape\color{glossink}#1}}%
  \nobreak\vspace{.3em}%
  \@afterindentfalse\@afterheading}
\renewcommand{\thesection}{\Roman{section}}

% --- a fleuron before every section; an initial after every section head (01) -----
\newcommand{\atlas@fleuron}{%
  \par\addvspace{1.2em}\centerline{\pgfornament[width=18mm,color=rubric]{71}}\par}
% \section and \subsection are wrapped rather than hooked: a cmd/.../after
% hook on a \@startsection command fires before the argument is read.
% The head asks for its initial's room first: LaTeX keeps one line of the
% paragraph with a head, and a three-line initial at a head two lines from
% the foot hung below the page (lettrine's "ATTENTION REQUIRED", twice in
% each of two manuscripts). Eight lines: the fleuron and its space, the
% head with its skips, the initial's three. And the head's own \@secpenalty,
% which invites a page break before a section, is raised for the head that
% follows a fleuron, or the fleuron is left alone at the foot of the page.
\let\atlas@grand@section\section
\RenewDocumentCommand{\section}{s o m}{%
  \everypar{}%
  \needspace{8\baselineskip}%
  \edef\atlas@secpenalty{\the\@secpenalty}%
  \ifnum\value{section}>0 \atlas@fleuron\@secpenalty\@M\fi
  \IfBooleanTF{#1}{\atlas@grand@section*{#3}}
    {\IfValueTF{#2}{\atlas@grand@section[#2]{#3}}{\atlas@grand@section{#3}}}%
  \@secpenalty\atlas@secpenalty\relax
  \global\atlas@initialpendingtrue\atlas@arminitial}
\let\atlas@grand@subsection\subsection
\RenewDocumentCommand{\subsection}{s o m}{%
  \everypar{}%
  \IfBooleanTF{#1}{\atlas@grand@subsection*{#3}}
    {\IfValueTF{#2}{\atlas@grand@subsection[#2]{#3}}{\atlas@grand@subsection{#3}}}%
  \ifatlas@initialpending\atlas@arminitial\fi}
% Armed by the section wrapper; a subsection head that follows re-arms it;
% it fires at the next paragraph whose first token is a letter, and grabs
% the first word. A leading \label is stepped over; anything else (an
% environment, mathematics) disarms it quietly.
\newif\ifatlas@initialpending
\newcommand{\atlas@arminitial}{%
  \everypar{\everypar{}%
    \if@nobreak\@nobreakfalse\clubpenalty\@M{\setbox\z@\lastbox}\fi
    \atlas@initial@try}}
% The peek must run after this conditional's \fi is gone, or it sees the \fi.
\def\atlas@initial@try{%
  \ifatlas@initialpending\expandafter\atlas@initial@peek\fi}
\def\atlas@initial@peek{\futurelet\atlas@next\atlas@initial@check}
\def\atlas@initial@check{%
  \ifx\atlas@next\label
    \expandafter\atlas@initial@skiplabel
  \else
    \ifcat\noexpand\atlas@next a%
      \global\atlas@initialpendingfalse
      \expandafter\expandafter\expandafter\atlas@initial@grab
    \else
      \global\atlas@initialpendingfalse
    \fi
  \fi}
\def\atlas@initial@skiplabel\label#1{\label{#1}\atlas@initial@try}
\def\atlas@initial@grab#1#2 {%
  \lettrine[lines=3,loversize=0.08,findent=0.35em,nindent=0em]{\textcolor{rubric}{#1}}{#2} }

% --- the title leaf (07), framed (05), on a page of its own ---------------------------
\newif\ifatlas@titleleaf
\newcommand{\AtlasImprint}{%
  \begin{center}\footnotesize\color{rubric}
    \textls[90]{\textsc{Printed for the Author,}}\par
    \textls[90]{\textsc{and to be had at levineuwirth.org.}}\par
    \vspace{0.3em}
    \textls[90]{\textsc{mmxxvi.}}\par
  \end{center}}
% A long Table runs the front matter onto a second leaf; the frame follows
% (the flag is up until the \clearpage) and so must the empty page style,
% hence \pagestyle rather than \thispagestyle, restored afterwards. The
% leaves are ragged-bottom while they last: the class is flush-bottom, and
% a middle leaf of Table lines, which have no stretch, cannot be filled and
% was reported underfull; the last leaf has its \vfill before the imprint.
\renewcommand{\maketitle}{%
  \global\atlas@titleleaftrue
  \pagestyle{empty}%
  \let\atlas@grand@textbottom\@textbottom
  \raggedbottom
  \vspace*{6mm}%
  \atlas@titleleaf
  \atlas@fleuron
  \AtlasTable
  \vfill
  \AtlasImprint
  \clearpage
  \global\let\@textbottom\atlas@grand@textbottom
  \global\atlas@titleleaffalse
  \pagestyle{fancy}%
  \markboth{\shorttitle}{\shorttitle}%
  \global\let\maketitle\relax}

% --- the sheet beneath every page (06), the frame on the title leaf (05) ----------
\AddToHook{shipout/background}{\put(0,0){%
  \begin{tikzpicture}[overlay]
    \ifatlas@plain\else
      % laid paper: fine laid lines, chain lines at a hand's breadth
      \foreach \y in {0,1.15,...,297} {
        \draw[ink,opacity=0.04,line width=0.25pt] (0,-\y mm) -- (\paperwidth,-\y mm);
      }
      \foreach \x in {15,41,...,210} {
        \draw[ink,opacity=0.06,line width=0.55pt] (\x mm,0) -- (\x mm,-\paperheight);
      }
      % foxing: the seed is set once (below), so the spots differ page to
      % page and are the same on every run
      \foreach \i in {1,...,55} {
        \pgfmathsetmacro{\fx}{rnd*210}
        \pgfmathsetmacro{\fy}{rnd*297}
        \pgfmathsetmacro{\fr}{0.3+rnd*rnd*2.2}
        \pgfmathsetmacro{\fo}{0.03+rnd*0.08}
        \fill[foxing,opacity=\fo] (\fx mm,-\fy mm) ellipse ({\fr mm} and {0.8*\fr mm});
      }
      \shade[inner color=parchment,outer color=foxing,opacity=0.09]
        (0,0) rectangle (\paperwidth,-\paperheight);
    \fi
    \ifatlas@titleleaf
      \coordinate (SE) at (\paperwidth,-\paperheight);
      \draw[rubric,line width=1.1pt] (16mm,-16mm) rectangle ($(SE)+(-16mm,16mm)$);
      \draw[rubric,line width=0.3pt] (18mm,-18mm) rectangle ($(SE)+(-18mm,18mm)$);
      \node[anchor=north west] at (19mm,-19mm)
        {\pgfornament[width=14mm,color=rubric]{61}};
      \node[anchor=north east] at ($(SE)+(-19mm,\paperheight-19mm)$)
        {\pgfornament[width=14mm,color=rubric,symmetry=v]{61}};
      \node[anchor=south west] at ($(SE)+(19mm-\paperwidth,19mm)$)
        {\pgfornament[width=14mm,color=rubric,symmetry=h]{61}};
      \node[anchor=south east] at ($(SE)+(-19mm,19mm)$)
        {\pgfornament[width=14mm,color=rubric,symmetry=c]{61}};
    \fi
  \end{tikzpicture}}}
\AtBeginDocument{\pgfmathsetseed{1683}}

% --- the hand press (06): text lines only, math glyphs left level -----------------
\begin{luacode*}
atlas = atlas or {}
atlas.jitter, atlas.inkspread, atlas.inking = 0.24, 0.06, 0.04
local seed = 1683
local function rnd()
  seed = (seed * 1103515245 + 12345) % 2147483648
  return seed / 1073741824 - 1
end
local GLYPH, HLIST, VLIST = node.id("glyph"), node.id("hlist"), node.id("vlist")
-- Is this glyph's font a math font? Read once per font id.
local mathfont = {}
local function is_math(fid)
  if mathfont[fid] == nil then
    local f = font.getfont(fid) or font.fonts[fid]
    local name = (f and (f.psname or f.fullname or f.name)) or ""
    mathfont[fid] = (name:find("Math") ~= nil)
  end
  return mathfont[fid]
end
local function scatter(head, amp)
  for n in node.traverse(head) do
    if n.id == GLYPH then
      if not is_math(n.font) then
        n.yoffset = n.yoffset + math.floor(amp * rnd() * 65536)
      end
    elseif (n.id == HLIST or n.id == VLIST) and n.head then
      scatter(n.head, amp)
    end
  end
end
local function literal(s)
  local w = node.new("whatsit", "pdf_literal")
  w.mode = 1
  w.data = s
  return w
end
local function impress(head)
  for line in node.traverse_id(HLIST, head) do
    if line.head then
      local w = atlas.inkspread + atlas.inking * rnd()
      if w > 0.005 then
        line.head = node.insert_before(line.head, line.head,
          literal(string.format("2 Tr %.3f w", w)))
        node.insert_after(line.head, node.tail(line.head), literal("0 Tr"))
      end
      if atlas.jitter > 0 then scatter(line.head, atlas.jitter) end
    end
  end
  return true
end
if not atlas.impress_registered then
  luatexbase.add_to_callback("post_linebreak_filter", impress, "atlas.impress")
  atlas.impress_registered = true
end
\end{luacode*}
\ifatlas@plain\directlua{atlas.jitter, atlas.inkspread, atlas.inking = 0, 0, 0}\fi

% --- the colophon: atlas's, with ornaments and a sentence on the sheet ---------------
\renewcommand{\atlas@colophon@ornament}{\pgfornament[width=22mm,color=rubric]{88}}
\renewcommand{\atlas@colophon@sheet}{%
  The paper is laid, foxed and darkened at the edges by computation; the
  impression of a hand press is counterfeited after the paragraphs are set,
  by scattering the baselines of the type and swelling its outline with
  ink, line by line, in a fixed and repeatable order.}
\let\atlas@grand@colophon\AtlasColophon
\renewcommand{\AtlasColophon}{\atlas@grand@colophon\AtlasImprint}

\endinput
