% The extravagant Beamer edition. LuaLaTeX, \usetheme{AtlasGrand}.
% A presentation layer over Atlas, independent of the old article packages.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAtlasGrand}[2026/11/04 v0.1 The grand Atlas]
\DeclareOptionBeamer{plain}{\PassOptionsToPackage{plain}{beamerthemeAtlas}}
\ProcessOptionsBeamer
\usetheme{Atlas}
\RequirePackage{tikz}
\usetikzlibrary{calc,patterns,decorations.pathmorphing,arrows.meta,shapes.geometric}
\RequirePackage{pgfornament}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{microtype}
\microtypesetup{protrusion=true,expansion=true}

\mode<presentation>
\ifatlasbeamer@plain
  \definecolor{AtlasGold}{gray}{.30}
  \definecolor{AtlasGoldLight}{gray}{.25}
  \definecolor{AtlasNight}{gray}{1}
  \definecolor{AtlasIvory}{gray}{0}
\else
  \definecolor{AtlasPaper}{HTML}{F2E6CC}
  \definecolor{AtlasInk}{HTML}{29221B}
  \definecolor{AtlasRubric}{HTML}{862E2B}
  \definecolor{AtlasGold}{HTML}{9D7736}
  \definecolor{AtlasGoldLight}{HTML}{D9B879}
  \definecolor{AtlasNight}{HTML}{182D30}
  \definecolor{AtlasIvory}{HTML}{F5E8C9}
\fi
\newif\ifatlasgrand@night
\newcommand{\AtlasGrandNight}{%
  \atlasgrand@nighttrue
  \setbeamercolor{normal text}{fg=AtlasIvory,bg=AtlasNight}%
  \setbeamercolor{structure}{fg=AtlasGoldLight}%
  \setbeamercolor{frametitle}{fg=AtlasIvory}%
  \setbeamercolor{framesubtitle}{fg=AtlasGoldLight}%
  \setbeamercolor{page number in head/foot}{fg=AtlasGoldLight}%
  \setbeamercolor{alerted text}{fg=AtlasGoldLight}%
}
\newcommand{\AtlasGrandFleuron}[1][18mm]{%
  \pgfornament[width=#1,color=AtlasGold]{71}}
\newcommand{\AtlasGrandRubric}[1]{%
  {\color{AtlasRubric}\textls[110]{\textsc{#1}}}}
\newcommand{\AtlasGrandKicker}[1]{%
  {\small\color{AtlasGold}\textls[140]{\textsc{#1}}\par}}

% Deterministic paper and astronomical linework: nothing changes with the
% overlay number. Clipping keeps every mark inside the physical slide.
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}[remember picture,overlay]
    \clip (current page.south west) rectangle (current page.north east);
    \ifatlasgrand@night
      \fill[AtlasNight] (current page.south west) rectangle (current page.north east);
      \begin{scope}[shift={(current page.center)},draw=AtlasGoldLight,opacity=.09]
        \foreach \r in {17,25,33,41,49,57,65,73}
          \draw[line width=.25pt] (0,0) circle (\r mm);
        \foreach \a in {0,15,...,345}
          \draw[line width=.2pt] (0,0)--(\a:110mm);
        \draw[rotate=25] (0,0) ellipse (75mm and 22mm);
        \draw[rotate=-25] (0,0) ellipse (75mm and 22mm);
      \end{scope}
      \def\atlasgrand@border{AtlasGoldLight}%
    \else
      \fill[AtlasPaper] (current page.south west) rectangle (current page.north east);
      \ifatlasbeamer@plain\else
        \foreach \y in {0,1.1,...,130}
          \draw[AtlasGold,opacity=.065,line width=.18pt]
            ([yshift=-\y mm]current page.north west)--([yshift=-\y mm]current page.north east);
        \foreach \x in {12,32,...,212}
          \draw[AtlasGold,opacity=.08,line width=.35pt]
            ([xshift=\x mm]current page.south west)--([xshift=\x mm]current page.north west);
        % Foxing stays at the edge, off the argument and its symbols.
        \foreach \i in {1,...,26} {
          \pgfmathsetmacro{\xx}{7+mod(\i*37,145)}
          \pgfmathsetmacro{\yy}{1+mod(\i*7,5)}
          \pgfmathsetmacro{\rr}{.25+mod(\i*3,9)/8}
          \fill[AtlasGold,opacity=.055]
            ([xshift=\xx mm,yshift=\yy mm]current page.south west)
            ellipse (\rr mm and .4mm);
        }
      \fi
      \def\atlasgrand@border{AtlasGold}%
    \fi
    \draw[\atlasgrand@border,line width=.8pt]
      ([xshift=3.3mm,yshift=3.3mm]current page.south west)
      rectangle ([xshift=-3.3mm,yshift=-3.3mm]current page.north east);
    \draw[\atlasgrand@border,line width=.25pt]
      ([xshift=4.5mm,yshift=4.5mm]current page.south west)
      rectangle ([xshift=-4.5mm,yshift=-4.5mm]current page.north east);
    \node[anchor=north west,inner sep=0pt] at
      ([xshift=5.1mm,yshift=-5.1mm]current page.north west)
      {\pgfornament[width=8mm,color=\atlasgrand@border]{61}};
    \node[anchor=north east,inner sep=0pt] at
      ([xshift=-5.1mm,yshift=-5.1mm]current page.north east)
      {\pgfornament[width=8mm,color=\atlasgrand@border,symmetry=v]{61}};
    \node[anchor=south west,inner sep=0pt] at
      ([xshift=5.1mm,yshift=5.1mm]current page.south west)
      {\pgfornament[width=8mm,color=\atlasgrand@border,symmetry=h]{61}};
    \node[anchor=south east,inner sep=0pt] at
      ([xshift=-5.1mm,yshift=5.1mm]current page.south east)
      {\pgfornament[width=8mm,color=\atlasgrand@border,symmetry=c]{61}};
  \end{tikzpicture}%
}

\setbeamersize{text margin left=14mm,text margin right=14mm}
\setbeamerfont{frametitle}{size=\Large,shape=\scshape}
\setbeamerfont{framesubtitle}{size=\small,shape=\normalshape\itshape}
\setbeamertemplate{headline}{\vskip5mm}
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\textwidth,sep=0pt]{frametitle}
    \vskip1mm
    \raggedright\usebeamerfont{frametitle}\strut\insertframetitle\strut\par
    \ifx\insertframesubtitle\@empty\else
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
       \insertframesubtitle\strut\par}
    \fi
    \vskip.6mm
    {\color{AtlasGold}\hrule height .6pt\vskip.6mm\hrule height .2pt}
    \vskip1mm
  \end{beamercolorbox}%
}
\setbeamertemplate{footline}{%
  % Keep the baseline above the inner border (4.5mm from the page edge),
  % with room for descenders. Keep the original 8.3mm total footer height.
  \begin{beamercolorbox}[wd=\paperwidth,ht=2mm,dp=6.3mm,leftskip=14mm,rightskip=14mm]{page number in head/foot}
    \scriptsize
    \ifatlasgrand@night\color{AtlasGoldLight}\else\color{AtlasGold}\fi
    \textsc{\insertsectionhead}\hfill
    \textsc{folio}\enspace\@Roman{\insertframenumber}
    \enspace/\enspace\inserttotalframenumber
  \end{beamercolorbox}%
}
\setbeamertemplate{itemize item}{\raise.15ex\hbox{\color{AtlasGold}\tiny$\blacklozenge$}}
\setbeamertemplate{enumerate item}{\textcolor{AtlasRubric}{\scshape\romannumeral\insertenumlabel.}}
\setbeamertemplate{qed symbol}{\textcolor{AtlasGold}{\textsc{Q.E.D.}}}

% A native Beamer theorem still owns its counter, label, and overlays.
% The ornament belongs to the block template, not to a replacement theorem.
\tcbset{atlas grand block/.style={enhanced,sharp corners,boxrule=.35pt,
  colframe=AtlasGold,colback=AtlasPaper!80!white,coltext=AtlasInk,
  left=3mm,right=3mm,top=1.5mm,bottom=1.5mm,
  before skip=2mm,after skip=2mm,fonttitle=\normalfont\scshape,
  before upper=\raggedright,
  colbacktitle=AtlasRubric,coltitle=AtlasPaper,
  borderline={.25pt}{1pt}{AtlasGold},title={\insertblocktitle}}}
\setbeamertemplate{block begin}{\begin{tcolorbox}[atlas grand block]}
\setbeamertemplate{block end}{\end{tcolorbox}}
\setbeamertemplate{block alerted begin}{\begin{tcolorbox}[atlas grand block,
  colback=AtlasRubric!7!AtlasPaper,colframe=AtlasRubric]}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}
\setbeamertemplate{block example begin}{\begin{tcolorbox}[atlas grand block,
  colbacktitle=AtlasGold]}
\setbeamertemplate{block example end}{\end{tcolorbox}}

\newcommand{\AtlasGrandScholium}[2]{%
  \begin{tcolorbox}[enhanced,sharp corners,frame hidden,
    borderline west={1pt}{0pt}{AtlasGold},colback=AtlasGold!8!AtlasPaper,
    coltext=AtlasInk,left=3mm,right=2mm,top=2mm,bottom=2mm,
    before skip=2mm,after skip=2mm,before upper=\raggedright]
    {\color{AtlasRubric}\scshape #1\par}\smallskip
    {\small\itshape #2\par}
  \end{tcolorbox}%
}

% An illuminated letter in a real framed panel, not a bitmap or a font hack.
\newcommand{\AtlasGrandInitial}[1]{%
  \begin{tikzpicture}[baseline=(letter.base)]
    \fill[AtlasRubric] (0,0) rectangle (1.15,1.3);
    \draw[AtlasGoldLight,line width=.5pt] (.06,.06) rectangle (1.09,1.24);
    \foreach \a in {0,45,...,315}
      \draw[AtlasGoldLight,opacity=.5,line width=.25pt]
        (.575,.65)--++(\a:.52);
    \node[anchor=center,text=AtlasPaper,font=\fontsize{34}{34}\selectfont,
      inner sep=0pt] (letter) at (.575,.67) {#1};
  \end{tikzpicture}%
}

% A compass/armillary frontispiece. All elements remain vector paths.
\newcommand{\AtlasGrandAstrolabe}[1][55mm]{%
  \resizebox{#1}{!}{%
  \begin{tikzpicture}[draw=AtlasGoldLight,text=AtlasGoldLight,line width=.45pt]
    \path[use as bounding box] (-3.35,-3.35) rectangle (3.35,3.35);
    \foreach \r in {2.42,2.54,2.77,2.88,3.05}\draw (0,0) circle (\r);
    \foreach \a in {0,5,...,355}\draw (\a:2.77)--(\a:2.86);
    \foreach \a in {0,30,...,330}{
      \draw[line width=.8pt] (\a:2.66)--(\a:2.88);
      \node[rotate=\a-90,font=\tiny] at (\a:3.22) {\a};
    }
    \draw[rotate=32] (0,0) ellipse (2.42 and .82);
    \draw[rotate=-32] (0,0) ellipse (2.42 and .82);
    \draw (0,0) ellipse (.82 and 2.42);
    \draw (0,0) ellipse (2.42 and .82);
    \foreach \a in {0,45,...,315}{
      \fill[AtlasGoldLight,opacity=.2] (\a:2.3)--(\a+8:.9)--(0,0)--cycle;
      \draw (\a:2.3)--(\a-8:.9)--(0,0)--(\a+8:.9)--cycle;
    }
    \fill[AtlasNight] (0,0) circle (1.08);
    \draw[double,double distance=1.6pt] (0,0) circle (1.08);
    \foreach \x/\y/\name in {0/-.7/a,0/-.1/b,-.55/.55/c,.55/.55/d,0/.75/e}
      \coordinate (\name) at (\x,\y);
    \draw[line width=1.3pt] (a)--(b)--(c) (b)--(d) (b)--(e);
    \foreach \name in {a,b,c,d,e}\fill[AtlasGoldLight] (\name) circle (.07);
    \foreach \a in {0,90,180,270}\fill[AtlasNight] (\a:2.54) circle (.12);
    \foreach \a in {0,90,180,270}\draw (\a:2.54) circle (.12);
  \end{tikzpicture}}%
}

\newcommand{\AtlasGrandChapter}[3]{%
  \begingroup\AtlasGrandNight
  \begin{frame}[plain,noframenumbering]
    \centering
    \vspace*{3mm}
    {\color{AtlasGoldLight}\pgfornament[width=34mm,color=AtlasGoldLight]{71}\par}
    \medskip
    {\color{AtlasGoldLight}\small\textls[180]{\textsc{Liber #1}}\par}
    \bigskip
    {\color{AtlasIvory}\fontsize{30}{35}\selectfont\scshape #2\par}
    \medskip
    {\color{AtlasIvory}\large\itshape #3\par}
    \bigskip
    \AtlasGrandAstrolabe[25mm]
  \end{frame}
  \endgroup
}

% The generic title template uses standard Beamer metadata.
\setbeamertemplate{title page}{%
  \centering
  \AtlasGrandFleuron[30mm]\par\medskip
  {\color{AtlasRubric}\small\textls[160]{\textsc{A mathematical discourse}}\par}
  \bigskip
  {\fontsize{30}{34}\selectfont\scshape\inserttitle\par}
  \medskip
  {\large\itshape\insertsubtitle\par}
  \bigskip
  {\insertauthor\par}\smallskip
  {\small\insertinstitute\par\insertdate\par}
  \medskip\AtlasGrandFleuron[20mm]
}
\mode<all>
