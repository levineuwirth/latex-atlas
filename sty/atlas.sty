% SPDX-License-Identifier: CC-BY-SA-4.0
% atlas.sty v0: the treatments the lab has graduated, lifted from the common
% preamble of plates 04, 07 and 08, for an existing article or amsart
% manuscript. Load it LAST in the preamble, after the manuscript's own
% \newtheorem calls and after hyperref, then name the manuscript's theorem
% environments to the apparatus (see \AtlasProposition below). The
% manuscript body is not edited.
%
% Options:
%   plain          white paper and black ink (print, arXiv)
%   rareligatures  the period's ct/st ties (07 --no-ligatures showed a
%                  functional preprint wants them off; default off)
%
% What it sets: EB Garamond with Garamond-Math (Pagella pair as fallback,
% and Pagella Math for the symbols Garamond-Math lacks), old-style figures
% in prose and lining ones in tables and in the text of links, microtype's
% protrusion and expansion, the parchment stock and ink of 04/07/08 and
% their geometry on A4, spaced small-capital heads for sections, a title
% leaf after 07 with "The Argument" in place of the abstract and the
% class's first-page footnotes (keywords, subject class, \thanks) beneath,
% the proposition apparatus of 04 (centred head, attribution beneath,
% italic statement, Demonstration, Q.E.D., run-in definitions and
% scholia), a running head under a hair rule and a centred folio, and 08's
% "The Authorities" head and small type for the reference list.
% Bibliography *entries* are left as the manuscript sets them; 08's
% biblatex style graduates separately.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atlas}[2026/09/16 v0 latex-atlas graduated treatments]

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{atlas}{atlas.sty requires LuaLaTeX}{Run lualatex, not pdflatex.}
\fi

\newif\ifatlas@plain
\newif\ifatlas@rare
\DeclareOption{plain}{\atlas@plaintrue}
\DeclareOption{rareligatures}{\atlas@raretrue}
\DeclareOption*{\PackageWarning{atlas}{Unknown option \CurrentOption}}
\ProcessOptions\relax

% --- faces ------------------------------------------------------------------
\RequirePackage{fontspec}
% A manuscript that loads mathtools ahead of this file gets two unicode-math
% warnings at \begin{document}: that mathtools keeps \overbracket and
% \underbracket, and that \coloneqq and its three siblings become
% unicode-math's single glyphs. Both are unicode-math's own decisions,
% made because this file loaded it; neither asks the author for anything.
\PassOptionsToPackage{warnings-off={mathtools-colon,mathtools-overbracket}}{unicode-math}
\RequirePackage{unicode-math}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
% microtype may already be loaded by the manuscript; no options here, so no
% clash, and the settings go through \microtypesetup. Tracking supplies
% \textls for the heads. Protrusion and expansion are ON, which the plates'
% HarfBuzz renderer cannot do: the plates inherited HarfBuzz from 01 without
% a reason, and a 35-page manuscript on this measure set eight overfull
% lines (up to 17 pt) without expansion and none with it. The node renderer
% keeps everything the plates use -- tracking, small capitals, old-style
% figures, the common and the rare ligatures -- compared on a title leaf.
\RequirePackage{microtype}
\microtypesetup{tracking=true,protrusion=true,expansion=true}

\defaultfontfeatures{Renderer=Node}
\ifatlas@rare
  \defaultfontfeatures+[EB Garamond]{Ligatures=Rare}
\fi
\IfFontExistsTF{EB Garamond}{
  \setmainfont{EB Garamond}[
    Numbers={OldStyle,Proportional},
    Ligatures={TeX,Common}
  ]
}{
  \setmainfont{TeX Gyre Pagella}[
    Numbers={OldStyle,Proportional},
    Ligatures={TeX,Common}
  ]
}
\IfFontExistsTF{Garamond-Math.otf}{
  \setmathfont{Garamond-Math.otf}[StylisticSet={5,7}]
  % Garamond-Math lacks 54 of unicode-math's symbols that Pagella Math has,
  % and a missing character is dropped from the page with only a log line
  % to say so (a manuscript's \sharp came out as nothing). These are they,
  % found by setting every command of unicode-math-table.tex under each
  % font and reading the two logs: the ≗ ≜ ≝ family, the card suits, the
  % accidentals, ⪋ ⪌ ⪕ ⪖, the checkmark and the maltese cross, and the
  % bold sans-serif ∂ ϰ ϕ ϱ ϖ. luaotfload's fallback= feature does not
  % reach math fonts, so the list is explicit; regenerate it if either
  % font changes.
  \setmathfont{TeX Gyre Pagella Math}[range={
    "2257-"225F, "2305-"2306, "2320-"2321, "23AE, "23B2-"23B3,
    "2422-"2423, "2591-"2593, "2660-"2667, "266A, "266D-"266F,
    "2713, "2720, "27E0-"27E3, "27F4, "2A8B-"2A8C, "2A95-"2A96,
    "1D789, "1D78C-"1D78F, "1D7C3, "1D7C6-"1D7C9}]
}{
  \setmathfont{TeX Gyre Pagella Math}
}

% --- stock, ink, page ---------------------------------------------------------
\ifatlas@plain
  \definecolor{parchment}{HTML}{FFFFFF}
  \definecolor{ink}{HTML}{000000}
\else
  \definecolor{parchment}{HTML}{F5ECDB}
  \definecolor{ink}{HTML}{241F19}
\fi
\pagecolor{parchment}
\color{ink}
\geometry{a4paper,top=30mm,bottom=30mm,left=34mm,right=34mm,headheight=14pt,headsep=8mm}
\setlength{\parindent}{1.1em}
\setlength{\parskip}{0pt}
% Loaded last, so hyperref, if the manuscript uses it, is already there.
\@ifpackageloaded{hyperref}{\hypersetup{colorlinks=true,allcolors=ink}}{}
% 08's rule, prose figures old-style and codes lining, applied to the text
% of every external link: a DOI or an arXiv number hand-set as
% \href{...}{10.1016/...} is text, and took the old-style figures ("IO.IOI6").
% \url escapes only because its digits are set in math mode. The driver's
% \hyper@linkurl{text}{url} is the one place both go through.
\@ifpackageloaded{hyperref}{%
  \@ifundefined{hyper@linkurl}{}{%
    \let\atlas@linkurl\hyper@linkurl
    \def\hyper@linkurl#1#2{\atlas@linkurl{{\addfontfeature{Numbers=Lining}#1}}{#2}}}}{}

% --- tables -----------------------------------------------------------------------
% 03's finding: a table's figures are lining and tabular, so columns align.
% A manuscript's table mixes text cells and math cells, and the math font's
% digits are lining already; without this a column of years in text sat
% old-style beside a column of values in math. A table of words is untouched.
\AddToHook{env/tabular/begin}{\addfontfeature{Numbers={Lining,Tabular}}}
\AddToHook{env/tabular*/begin}{\addfontfeature{Numbers={Lining,Tabular}}}
\AddToHook{env/tabularx/begin}{\addfontfeature{Numbers={Lining,Tabular}}}
\AddToHook{env/longtable/begin}{\addfontfeature{Numbers={Lining,Tabular}}}

% --- heads ----------------------------------------------------------------------
% \atlas@head[note]{text}: centred spaced small capitals, with an italic note
% beneath if given. 04's \prophead.
\NewDocumentCommand{\atlas@head}{o m}{%
  \par\addvspace{1.1em plus .3em}%
  \centerline{\small\textls[120]{\textsc{#2}}}%
  \IfValueT{#1}{\nobreak\vspace{.1em}\centerline{\footnotesize\itshape #1}}%
  \nobreak\vspace{.3em}%
  % Stay in vertical mode and let the next paragraph start flush, as a
  % section head does: a \label on the line after \begin{theorem} then
  % leaves no stray space at the head of the statement.
  \@afterindentfalse\@afterheading}
% Sections in the same voice. The small capitals are letterspaced by the
% tracking set (shape sc), not by \lsstyle in the style argument, which
% swallows amsart's \enspace after the number. Subsections are set on their
% own line in italic: a run-in head placed directly before a proposition
% would otherwise be deferred into the statement's first line.
\def\section{\@startsection{section}{1}%
  \z@{1.4em\@plus .5em}{.7em}%
  {\normalfont\small\centering\scshape}}
\def\subsection{\@startsection{subsection}{2}%
  \z@{.9em\@plus .4em}{.3em}%
  {\normalfont\itshape}}
\SetTracking{encoding=*,shape=sc}{120}

% --- the apparatus ------------------------------------------------------------
% The manuscript has already said \newtheorem{lemma}[theorem]{Lemma}; these
% re-dress that environment in place. Arguments: the environment, its
% caption, and in brackets the counter it steps (the shared one, for
% [theorem]-style sharing); without the bracket the environment is
% unnumbered, as remark* is.
%   \AtlasProposition{theorem}{Theorem}[theorem]   centred head, attribution
%                                                  beneath, italic statement
%   \AtlasDefinition{definition}{Definition}[theorem]  run-in small-capital
%                                                  head, upright body
%   \AtlasScholium{remark}{Scholium}[theorem]      run-in head, body set small
%   \AtlasScholium{remark*}{Scholium}              the same, unnumbered
% The counter is stepped before the head is set, outside every box and
% group: \refstepcounter inside \centerline or \textls leaves \@currentlabel
% behind when the box closes, and \label then records the section.
\NewDocumentCommand{\atlas@step}{o}{\IfValueT{#1}{\refstepcounter{#1}}}
\NewDocumentCommand{\atlas@number}{m o}{%
  \IfValueT{#2}{~\csname the#1\endcsname}}
\NewDocumentCommand{\AtlasProposition}{m m o}{%
  \RenewDocumentEnvironment{#1}{o}
    {\atlas@step[#3]%
     \atlas@head[##1]{#2\atlas@number{#1}[#3].}\itshape\ignorespaces}
    {\par}}
\NewDocumentCommand{\atlas@runin}{m o}{%
  \par\addvspace{.7em}\noindent
  \textls[100]{\textsc{#1}}\IfValueT{#2}{ (#2)}.\ \ignorespaces}
\NewDocumentCommand{\AtlasDefinition}{m m o}{%
  \RenewDocumentEnvironment{#1}{o}
    {\atlas@step[#3]%
     \atlas@runin{#2\atlas@number{#1}[#3]}[##1]\upshape\ignorespaces}
    {\par}}
\NewDocumentCommand{\AtlasScholium}{m m o}{%
  \RenewDocumentEnvironment{#1}{o}
    {\atlas@step[#3]\small
     \atlas@runin{#2\atlas@number{#1}[#3]}[##1]\ignorespaces}
    {\par}}
\renewcommand{\proofname}{Demonstration}
\renewcommand{\qedsymbol}{\textls[60]{\textsc{q.e.d.}}}

% --- the title leaf --------------------------------------------------------------
% After 07: the title in spaced capitals, the author set off by "by", the
% address and date small, a double rule; then The Argument in the full
% measure. Reads amsart's \@title, \authors, \addresses, \@date, and article's
% \@author if amsart is not the class. The abstract is boxed as amsart does,
% so the source order (abstract before \maketitle) is kept.
\providecommand{\authors}{\@author}
\providecommand{\addresses}{}
\providecommand{\shorttitle}{\@title}
\newbox\atlas@abstractbox
\renewenvironment{abstract}{%
  \global\setbox\atlas@abstractbox=\vtop\bgroup
    \hsize\textwidth
    \atlas@head{The Argument.}\small\noindent\ignorespaces}
  % article's order is \maketitle then abstract: the leaf has been set, so
  % set the Argument here, as amsart does for an abstract that comes late.
  {\par\egroup\ifx\maketitle\relax\atlas@setabstract\fi}
% The Argument, then the space amsart leaves before the body (34 pt less a
% line): a manuscript whose body opens with a paragraph, not a section,
% would otherwise run straight on from the abstract's last line.
\newcommand{\atlas@setabstract}{%
  \ifvoid\atlas@abstractbox\else
    \box\atlas@abstractbox\prevdepth\z@
    \dimen@34\p@ \advance\dimen@-\baselineskip \vskip\dimen@\relax
  \fi}
\renewcommand{\maketitle}{%
  \thispagestyle{empty}%
  \begingroup
  \def\address##1##2{{\small\itshape ##2}\par}%
  \def\curraddr##1##2{}\def\email##1##2{}\def\urladdr##1##2{}%
  \def\and{\ and\ }%
  % hyperref wraps \maketitle to use the unpatched footnote commands inside
  % it (its anchors need a mark that these footnotes never get). This
  % \renewcommand replaced that wrapper, so do what it did, in this group.
  \@ifundefined{H@@footnotetext}{}{%
    \let\@footnotetext\H@@footnotetext \let\@footnotemark\H@@footnotemark}%
  % amsart's first-page footnotes, unmarked: subject class, keywords and
  % \thanks, as its \@adminfootnotes sets them; the date is not repeated,
  % the leaf gives it.
  {\let\@makefnmark\relax \let\@thefnmark\relax
   \@ifundefined{@subjclass}{}{\ifx\@empty\@subjclass\else\@footnotetext{\@setsubjclass}\fi}%
   \@ifundefined{@keywords}{}{\ifx\@empty\@keywords\else\@footnotetext{\@setkeywords}\fi}%
   \@ifundefined{thankses}{}{\ifx\@empty\thankses\else\@footnotetext{\def\par{\let\par\@par}\@setthanks}\fi}}%
  % article's \thanks: a symbol mark in the author line, the text as a
  % footnote after the leaf, as its \maketitle does.
  \renewcommand\thefootnote{\@fnsymbol\c@footnote}%
  \begin{center}
    % A manuscript's hand-placed \\ was set for its own class's measure;
    % in spaced capitals the title is let to flow. Redefined here, inside
    % center, which has just made \\ its own.
    {\Large\def\\{\unskip\space\ignorespaces}%
     \textls[160]{\MakeUppercase{\@title}}}\par
    \vspace{1.2em}
    {\small by}\par
    \vspace{0.3em}
    {\small\textls[140]{\textsc{\authors}}}\par
    \addresses
    \vspace{0.3em}
    {\small\@date}\par
    \vspace{1.2em}
    \rule{0.45\linewidth}{0.8pt}\par\nointerlineskip
    \vspace{1.6pt}\rule{0.45\linewidth}{0.3pt}\par
  \end{center}
  \@ifundefined{@thanks}{}{\@thanks\global\let\@thanks\@empty}%
  \endgroup
  \atlas@setabstract
  \markboth{\shorttitle}{\shorttitle}%
  \global\let\maketitle\relax}

% --- running head and folio ------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\textls[90]{\textsc{\shorttitle}}}
\fancyfoot[C]{\footnotesize\itshape --- \thepage\ ---}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\footrulewidth}{0pt}

% --- the authorities -------------------------------------------------------------
% 08's head and size for whatever list the manuscript sets; entries are the
% manuscript's own. amsart's \@bibtitlestyle if present, else \refname.
\@ifundefined{@bibtitlestyle}{}{%
  \renewcommand{\@bibtitlestyle}{\atlas@head{The Authorities.}}}
% amsart repeats the addresses after the references; the title leaf has
% already given them.
\@ifundefined{@setaddresses}{}{\renewcommand{\@setaddresses}{}}
\@ifundefined{bibliofont}{}{\renewcommand{\bibliofont}{\small}}
\renewcommand{\refname}{The Authorities}

\endinput
