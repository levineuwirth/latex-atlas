% SPDX-License-Identifier: CC-BY-SA-4.0
% atlas.sty v0: the treatments the lab has graduated, lifted from the common
% preamble of plates 04, 07 and 08, for an existing article or amsart
% manuscript. Load it LAST in the preamble, after the manuscript's own
% \newtheorem calls and after hyperref, then name the manuscript's theorem
% environments to the apparatus (see \AtlasProposition below). The
% manuscript body is not edited.
%
% Options:
%   plain          white paper and black ink (print, arXiv)
%   rareligatures  the period's ct/st ties (07 --no-ligatures showed a
%                  functional preprint wants them off; default off)
%
% What it sets: EB Garamond with Garamond-Math (Pagella pair as fallback,
% and Pagella Math for the symbols Garamond-Math lacks), the manuscript's
% typewriter scaled to the text face, old-style figures in prose and lining
% ones in tables and in the text of links, microtype's protrusion and
% expansion, a third pass of line breaking (\emergencystretch) and a break
% after a dash between letters, the parchment stock and ink of 04/07/08
% and their geometry on A4, spaced small-capital heads for sections, a
% title leaf after 07 (the title in balanced spaced capitals -- or, with
% \AtlasSplitTitle, what follows its first \\ in italic beneath -- "The
% Argument" in place of
% the abstract, the class's first-page footnotes -- keywords, subject
% class, \thanks -- beneath), the proposition apparatus of 04 (centred
% head, attribution beneath, italic statement, Demonstration, Q.E.D.,
% run-in definitions and scholia; cleveref and nameref told what amsthm
% would have told them), a running head under a hair rule and a centred
% folio, and 08's "The Authorities" head and small type for the reference
% list. On call: \AtlasTable, a Table of the Propositions with real pages
% from the .aux (two passes), and \AtlasColophon, a colophon leaf naming
% faces, engine, sources and revision. Bibliography *entries* are left as
% the manuscript sets them; 08's biblatex style graduates separately.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atlas}[2026/09/16 v0 latex-atlas graduated treatments]

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{atlas}{atlas.sty requires LuaLaTeX}{Run lualatex, not pdflatex.}
\fi

\newif\ifatlas@plain
\newif\ifatlas@rare
\DeclareOption{plain}{\atlas@plaintrue}
\DeclareOption{rareligatures}{\atlas@raretrue}
\DeclareOption*{\PackageWarning{atlas}{Unknown option \CurrentOption}}
\ProcessOptions\relax

% --- faces ------------------------------------------------------------------
\RequirePackage{fontspec}
% A manuscript that loads mathtools ahead of this file gets two unicode-math
% warnings at \begin{document}: that mathtools keeps \overbracket and
% \underbracket, and that \coloneqq and its three siblings become
% unicode-math's single glyphs. Both are unicode-math's own decisions,
% made because this file loaded it; neither asks the author for anything.
\PassOptionsToPackage{warnings-off={mathtools-colon,mathtools-overbracket}}{unicode-math}
\RequirePackage{unicode-math}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
% microtype may already be loaded by the manuscript; no options here, so no
% clash, and the settings go through \microtypesetup. Tracking supplies
% \textls for the heads. Protrusion and expansion are ON, which the plates'
% HarfBuzz renderer cannot do: the plates inherited HarfBuzz from 01 without
% a reason, and a 35-page manuscript on this measure set eight overfull
% lines (up to 17 pt) without expansion and none with it. The node renderer
% keeps everything the plates use -- tracking, small capitals, old-style
% figures, the common and the rare ligatures -- compared on a title leaf.
\RequirePackage{microtype}
\microtypesetup{tracking=true,protrusion=true,expansion=true}

\defaultfontfeatures{Renderer=Node}
\ifatlas@rare
  \defaultfontfeatures+[EB Garamond]{Ligatures=Rare}
\fi
\IfFontExistsTF{EB Garamond}{
  \setmainfont{EB Garamond}[
    Numbers={OldStyle,Proportional},
    Ligatures={TeX,Common}
  ]
}{
  \setmainfont{TeX Gyre Pagella}[
    Numbers={OldStyle,Proportional},
    Ligatures={TeX,Common}
  ]
}
% The typewriter, when a manuscript uses one (\texttt, \url, \nolinkurl),
% is fontspec's default Latin Modern Mono, left at nominal size: beside
% EB Garamond's small lowercase it read a size larger, and a paragraph of
% file names on this measure set two overfull lines of it. Scaled to the
% text face's x-height, as fontspec provides for. The face is not changed.
\IfFontExistsTF{Latin Modern Mono}{
  \setmonofont{Latin Modern Mono}[Scale=MatchLowercase]
}{}
\IfFontExistsTF{Garamond-Math.otf}{
  \setmathfont{Garamond-Math.otf}[StylisticSet={5,7}]
  % Garamond-Math lacks 54 of unicode-math's symbols that Pagella Math has,
  % and a missing character is dropped from the page with only a log line
  % to say so (a manuscript's \sharp came out as nothing). These are they,
  % found by setting every command of unicode-math-table.tex under each
  % font and reading the two logs: the ≗ ≜ ≝ family, the card suits, the
  % accidentals, ⪋ ⪌ ⪕ ⪖, the checkmark and the maltese cross, and the
  % bold sans-serif ∂ ϰ ϕ ϱ ϖ. luaotfload's fallback= feature does not
  % reach math fonts, so the list is explicit; regenerate it if either
  % font changes.
  \setmathfont{TeX Gyre Pagella Math}[range={
    "2257-"225F, "2305-"2306, "2320-"2321, "23AE, "23B2-"23B3,
    "2422-"2423, "2591-"2593, "2660-"2667, "266A, "266D-"266F,
    "2713, "2720, "27E0-"27E3, "27F4, "2A8B-"2A8C, "2A95-"2A96,
    "1D789, "1D78C-"1D78F, "1D7C3, "1D7C6-"1D7C9}]
}{
  \setmathfont{TeX Gyre Pagella Math}
}

% --- stock, ink, page ---------------------------------------------------------
\ifatlas@plain
  \definecolor{parchment}{HTML}{FFFFFF}
  \definecolor{ink}{HTML}{000000}
\else
  \definecolor{parchment}{HTML}{F5ECDB}
  \definecolor{ink}{HTML}{241F19}
\fi
% The second colour of 01, here equal to the ink -- 01's own ablation -- so
% that a layer over this file can set it red and every head, rule and
% running head follows without a further edit.
\colorlet{rubric}{ink}
\pagecolor{parchment}
\color{ink}
% footskip is named: geometry keeps the class's otherwise, and amsart's is
% 12 pt, a line and a half from the last line of a full page to the folio.
\geometry{a4paper,top=30mm,bottom=30mm,left=34mm,right=34mm,
  headheight=14pt,headsep=8mm,footskip=8mm}
\setlength{\parindent}{1.1em}
\setlength{\parskip}{0pt}
% The measure is 402 pt against amsart's 469 on letter, and a mathematical
% paragraph has few places to break: an inline formula of 100 pt before its
% full stop, and the line that ends at "with" is 60 pt short. The class
% leaves \emergencystretch at zero, so such a paragraph gets no third pass
% and TeX sets the overfull line rather than the loose one. 2 em is the
% smallest of 1, 1.5, 2, 2.5, 3 and 4 em that set the two manuscripts which
% showed it without an overfull line; from 3 em up, paragraphs that had set
% well come out loose. It enters the badness calculation only when the
% first two passes have failed, and the one line it rescues is logged
% Underfull, as it should be: a formula that is half the measure, set
% inline, is the author's to display.
\setlength{\emergencystretch}{2em}
% TeX breaks a line after a hyphen -- the empty discretionary it puts after
% \hyphenchar, at \exhyphenpenalty -- and never after an en dash, so a
% compound of names, Bose--Esperet--Hodor--Joret--Micek--Rambaud, is one
% unbreakable word of 150 pt, and on this measure the paragraph had no
% feasible first line (the letter measure hid it). Between two letters an
% en or em dash now carries the break a hyphen does, by a node filter run
% after luaotfload has made the dash from its hyphens; a dash beside a
% figure (pages 3--5) or a space is left alone.
\directlua{
  local GLYPH, KERN, PENALTY = node.id("glyph"), node.id("kern"), node.id("penalty")
  local function letter(n, dir)
    local m = n[dir]
    while m and m.id == KERN do m = m[dir] end
    return m and m.id == GLYPH and tex.getlccode(m.char) > 0
  end
  local function dashes(head)
    for n in node.traverse_id(GLYPH, head) do
      if (n.char == 0x2013 or n.char == 0x2014)
         and letter(n, "prev") and letter(n, "next") then
        local p = node.new(PENALTY)
        p.penalty = tex.exhyphenpenalty
        node.insert_after(head, n, p)
      end
    end
    return head
  end
  luatexbase.add_to_callback("pre_linebreak_filter", dashes, "atlas.dashes")
}
% Loaded last, so hyperref, if the manuscript uses it, is already there.
\@ifpackageloaded{hyperref}{\hypersetup{colorlinks=true,allcolors=ink}}{}
% 08's rule, prose figures old-style and codes lining, applied to the text
% of every external link: a DOI or an arXiv number hand-set as
% \href{...}{10.1016/...} is text, and took the old-style figures ("IO.IOI6").
% \url escapes only because its digits are set in math mode. The driver's
% \hyper@linkurl{text}{url} is the one place both go through.
\@ifpackageloaded{hyperref}{%
  \@ifundefined{hyper@linkurl}{}{%
    \let\atlas@linkurl\hyper@linkurl
    \def\hyper@linkurl#1#2{\atlas@linkurl{{\addfontfeature{Numbers=Lining}#1}}{#2}}}}{}

% url's default forbids a break after a hyphen and allows one after a full
% stop, so a file name in a sentence broke as "hmghm-exterior-tree-setup."
% / "py" in the original and overran the measure here. Its hyphens option,
% too late to pass once hyperref has loaded it, is this one definition.
\@ifpackageloaded{url}{\def\do@url@hyp{\do\-}}{}

% --- tables -----------------------------------------------------------------------
% 03's finding: a table's figures are lining and tabular, so columns align.
% A manuscript's table mixes text cells and math cells, and the math font's
% digits are lining already; without this a column of years in text sat
% old-style beside a column of values in math. A table of words is untouched.
\AddToHook{env/tabular/begin}{\addfontfeature{Numbers={Lining,Tabular}}}
\AddToHook{env/tabular*/begin}{\addfontfeature{Numbers={Lining,Tabular}}}
\AddToHook{env/tabularx/begin}{\addfontfeature{Numbers={Lining,Tabular}}}
\AddToHook{env/longtable/begin}{\addfontfeature{Numbers={Lining,Tabular}}}

% --- heads ----------------------------------------------------------------------
% \atlas@head[note]{text}: centred spaced small capitals in the rubric, with
% an italic note beneath if given. 04's \prophead.
\NewDocumentCommand{\atlas@head}{o m}{%
  \par\addvspace{1.1em plus .3em}%
  \centerline{\small\textcolor{rubric}{\textls[120]{\textsc{#2}}}}%
  \IfValueT{#1}{\nobreak\vspace{.1em}\centerline{\footnotesize\itshape #1}}%
  \nobreak\vspace{.3em}%
  % Stay in vertical mode and let the next paragraph start flush, as a
  % section head does: a \label on the line after \begin{theorem} then
  % leaves no stray space at the head of the statement.
  \@afterindentfalse\@afterheading}
% Sections in the same voice. The small capitals are letterspaced by the
% tracking set (shape sc), not by \lsstyle in the style argument, which
% swallows amsart's \enspace after the number. Subsections are set on their
% own line in italic: a run-in head placed directly before a proposition
% would otherwise be deferred into the statement's first line.
\def\section{\@startsection{section}{1}%
  \z@{1.4em\@plus .5em}{.7em}%
  {\normalfont\small\centering\scshape\color{rubric}}}
\def\subsection{\@startsection{subsection}{2}%
  \z@{.9em\@plus .4em}{.3em}%
  {\normalfont\itshape}}
\SetTracking{encoding=*,shape=sc}{120}

% --- the apparatus ------------------------------------------------------------
% The manuscript has already said \newtheorem{lemma}[theorem]{Lemma}; these
% re-dress that environment in place. Arguments: the environment, its
% caption, and in brackets the counter it steps (the shared one, for
% [theorem]-style sharing); without the bracket the environment is
% unnumbered, as remark* is. Captions are the manuscript's own: prose may
% cross-refer to a kind by name, so a style does not rename one.
%   \AtlasProposition{theorem}{Theorem}[theorem]   centred head, attribution
%                                                  beneath, italic statement
%   \AtlasDefinition{definition}{Definition}[theorem]  run-in small-capital
%                                                  head, upright body
%   \AtlasScholium{remark}{Remark}[theorem]        run-in head, body set small
%   \AtlasScholium{remark*}{Remark}                the same, unnumbered
% The counter is stepped before the head is set, outside every box and
% group: \refstepcounter inside \centerline or \textls leaves \@currentlabel
% behind when the box closes, and \label then records the section.
% \atlas@step{env}[counter][name] steps the counter and tells the two
% packages that read amsthm's \@thm what it bypassed: cleveref types the
% label by the environment, not the counter (\refstepcounter[lemma]{theorem},
% its own amsthm patch), and nameref takes the theorem's name for \nameref
% (\NR@gettitle, as its \@begintheorem patch does; empty when there is no
% name, as there). Neither is done unless the package is loaded.
\NewDocumentCommand{\atlas@step}{m o o}{%
  \IfValueT{#2}{\atlas@refstep{#1}{#2}}%
  \@ifundefined{NR@gettitle}{}{\IfValueTF{#3}{\NR@gettitle{#3}}{\NR@gettitle{}}}}
\@ifpackageloaded{cleveref}
  {\newcommand{\atlas@refstep}[2]{\refstepcounter[#1]{#2}}}
  {\newcommand{\atlas@refstep}[2]{\refstepcounter{#2}}}
\NewDocumentCommand{\atlas@number}{m o}{%
  \IfValueT{#2}{~\csname the#1\endcsname}}
\NewDocumentCommand{\AtlasProposition}{m m o}{%
  \RenewDocumentEnvironment{#1}{o}
    {\atlas@step{#1}[#3][##1]%
     \atlas@writeprop{\IfValueTF{#3}{#2~\csname the#1\endcsname}{#2}}{\IfValueTF{##1}{##1}{}}%
     \atlas@head[##1]{#2\atlas@number{#1}[#3].}\itshape\ignorespaces}
    {\par}}
\NewDocumentCommand{\atlas@runin}{m o}{%
  \par\addvspace{.7em}\noindent
  \textls[100]{\textsc{#1}}\IfValueT{#2}{ (#2)}.\ \ignorespaces}
\NewDocumentCommand{\AtlasDefinition}{m m o}{%
  \RenewDocumentEnvironment{#1}{o}
    {\atlas@step{#1}[#3][##1]%
     \atlas@runin{#2\atlas@number{#1}[#3]}[##1]\upshape\ignorespaces}
    {\par}}
\NewDocumentCommand{\AtlasScholium}{m m o}{%
  \RenewDocumentEnvironment{#1}{o}
    {\atlas@step{#1}[#3][##1]\small
     \atlas@runin{#2\atlas@number{#1}[#3]}[##1]\ignorespaces}
    {\par}}
\renewcommand{\proofname}{Demonstration}
\renewcommand{\qedsymbol}{\textls[60]{\textsc{q.e.d.}}}

% --- the Table of the Propositions ---------------------------------------------------
% What 07 could only hand-set. Every \AtlasProposition environment writes
% one line to the .aux (kind and number, the name the manuscript gave,
% the page); \AtlasTable, placed where the author wants the index, prints
% them on the second pass under 07's head, with real pages. Statements are
% not captured, so the table gives kind, number and name. Nothing is
% printed unless \AtlasTable is called.
\newtoks\atlas@proptoks
\newif\ifatlas@hastable
\newcommand{\atlas@tableline}[3]{%
  \global\atlas@hastabletrue
  \global\atlas@proptoks\expandafter{\the\atlas@proptoks\atlas@tableentry{#1}{#2}{#3}}}
% A table line with a right-set page: the ToC idiom, without its dots.
\newcommand{\atlas@tableentry}[3]{%
  {\par\noindent\hangindent=1.5em\hangafter=1
   \rightskip=2.55em plus 1em \parfillskip=-\rightskip
   \textls[70]{\textsc{#1.}}\ \textit{#2}%
   \nobreak\hfill\nobreak\hbox to 1.55em{\hfil #3}\par}%
  \vspace{0.3em}}
\newcommand{\atlas@writeprop}[2]{%
  \protected@write\@auxout{}{\string\atlas@tableline{#1}{#2}{\thepage}}}
\newcommand{\AtlasTable}{%
  \ifatlas@hastable
    \atlas@head{A Table of the Propositions.}%
    \small\the\atlas@proptoks\normalsize
  \fi}

% --- the title leaf --------------------------------------------------------------
% After 07: the title in spaced capitals, the author set off by "by", the
% address and date small, a double rule; then The Argument in the full
% measure. Reads amsart's \@title, \authors, \addresses, \@date, and article's
% \@author if amsart is not the class. The abstract is boxed as amsart does,
% so the source order (abstract before \maketitle) is kept. The leaf is in
% pieces -- \atlas@titleblock, \atlas@titleleaf, \maketitle -- so that a
% layer over this file can put more on the leaf without repeating it.
\providecommand{\authors}{\@author}
\providecommand{\addresses}{}
\providecommand{\shorttitle}{\@title}
\newbox\atlas@abstractbox
\renewenvironment{abstract}{%
  \global\setbox\atlas@abstractbox=\vtop\bgroup
    \hsize\textwidth
    \atlas@head{The Argument.}\small\noindent\ignorespaces}
  % article's order is \maketitle then abstract: the leaf has been set, so
  % set the Argument here, as amsart does for an abstract that comes late.
  {\par\egroup\ifx\maketitle\relax\atlas@setabstract\fi}
% The Argument, then the space amsart leaves before the body (34 pt less a
% line): a manuscript whose body opens with a paragraph, not a section,
% would otherwise run straight on from the abstract's last line. The box
% is unpacked, not set: a box cannot break across pages, and when the leaf
% cannot hold the block and the whole Argument (the grand layer's measure
% made a long one longer) the box went whole to the next page and left the
% leaf underfull, as amsart's does. The Argument is prose; it may break.
\newcommand{\atlas@setabstract}{%
  \ifvoid\atlas@abstractbox\else
    \unvbox\atlas@abstractbox
    \dimen@34\p@ \advance\dimen@-\baselineskip \vskip\dimen@\relax
  \fi}
% A title's \\ is a line break as often as a subtitle: of four
% manuscripts, one named a subtitle there and two broke a phrase for
% amsart's measure ("...Critical Window for" / "Growing-Radius..."). A style
% cannot tell the two apart; the person injecting the preamble can. By
% default the title flows, in balanced capitals. \AtlasSplitTitle, in the
% injected preamble, sets what follows the first \\ beneath the capitals
% in italic, as 07 sets its "or," line; a further \\ in the subtitle
% breaks its line as written (center's own \\).
\newif\ifatlas@splittitle
\newcommand{\AtlasSplitTitle}{\atlas@splittitletrue}
\def\atlas@splittitle#1\\#2\atlas@stop{%
  \atlas@settitle#1\atlas@mark\atlas@stop
  \atlas@setsubtitle#2\atlas@mark\atlas@stop}
\def\atlas@settitle#1\atlas@mark#2\atlas@stop{\def\atlas@titlemain{#1}}
\def\atlas@setsubtitle#1\atlas@mark#2\atlas@stop{\def\atlas@titlesub{#1}}
% The block: title, subtitle, author, address, date, double rule.
\newcommand{\atlas@titleblock}{%
  \ifatlas@splittitle
    \expandafter\atlas@splittitle\@title\atlas@mark\\\atlas@stop
  \else
    \let\atlas@titlemain\@title \let\atlas@titlesub\@empty
  \fi
  \begin{center}
    % The capitals are centred with finite stretch at either side, not
    % center's fil: with fil every line is equally good and TeX fills the
    % first, leaving one word on the last ("... DEGREE-REDUCTION" / "CLOUDS");
    % with a finite amount a short last line costs badness, and the lines
    % come out balanced.
    % When the title flows, its \\ becomes a space; center has just made
    % \\ its own, so the redefinition sits here, inside.
    {\Large\color{rubric}%
     \ifatlas@splittitle\else\def\\{\unskip\space\ignorespaces}\fi
     \leftskip\z@\@plus.5\hsize \rightskip\leftskip \parfillskip\z@
     \textls[160]{\MakeUppercase{\atlas@titlemain}}\par}
    \ifx\atlas@titlesub\@empty\else
      \vspace{0.5em}
      {\large\itshape\atlas@titlesub\par}
    \fi
    \vspace{1.2em}
    {\small by}\par
    \vspace{0.3em}
    {\small\textls[140]{\textsc{\authors}}}\par
    \addresses
    \vspace{0.3em}
    {\small\@date}\par
    \vspace{1.2em}
    \textcolor{rubric}{\rule{0.45\linewidth}{0.8pt}}\par\nointerlineskip
    \vspace{1.6pt}\textcolor{rubric}{\rule{0.45\linewidth}{0.3pt}}\par
  \end{center}}
% The leaf: the block with the class's first-page footnotes, then the
% Argument.
\newcommand{\atlas@titleleaf}{%
  \begingroup
  \def\address##1##2{{\small\itshape ##2}\par}%
  \def\curraddr##1##2{}\def\email##1##2{}\def\urladdr##1##2{}%
  \def\and{\ and\ }%
  % hyperref wraps \maketitle to use the unpatched footnote commands inside
  % it (its anchors need a mark that these footnotes never get). This
  % \renewcommand replaced that wrapper, so do what it did, in this group.
  \@ifundefined{H@@footnotetext}{}{%
    \let\@footnotetext\H@@footnotetext \let\@footnotemark\H@@footnotemark}%
  % amsart's first-page footnotes, unmarked: subject class, keywords and
  % \thanks, as its \@adminfootnotes sets them; the date is not repeated,
  % the leaf gives it.
  {\let\@makefnmark\relax \let\@thefnmark\relax
   \@ifundefined{@subjclass}{}{\ifx\@empty\@subjclass\else\@footnotetext{\@setsubjclass}\fi}%
   \@ifundefined{@keywords}{}{\ifx\@empty\@keywords\else\@footnotetext{\@setkeywords}\fi}%
   \@ifundefined{thankses}{}{\ifx\@empty\thankses\else\@footnotetext{\def\par{\let\par\@par}\@setthanks}\fi}}%
  % article's \thanks: a symbol mark in the author line, the text as a
  % footnote after the leaf, as its \maketitle does.
  \renewcommand\thefootnote{\@fnsymbol\c@footnote}%
  \atlas@titleblock
  \@ifundefined{@thanks}{}{\@thanks\global\let\@thanks\@empty}%
  \endgroup
  \atlas@setabstract}
\renewcommand{\maketitle}{%
  \thispagestyle{empty}%
  \atlas@titleleaf
  \markboth{\shorttitle}{\shorttitle}%
  \global\let\maketitle\relax}

% --- running head and folio ------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\textcolor{rubric}{\textls[90]{\textsc{\shorttitle}}}}
\fancyfoot[C]{\footnotesize\itshape --- \thepage\ ---}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\footrulewidth}{0pt}

% --- the authorities -------------------------------------------------------------
% 08's head and size for whatever list the manuscript sets; entries are the
% manuscript's own. amsart's \@bibtitlestyle if present, else \refname.
\@ifundefined{@bibtitlestyle}{}{%
  \renewcommand{\@bibtitlestyle}{\atlas@head{The Authorities.}}}
% amsart repeats the addresses after the references; the title leaf has
% already given them.
\@ifundefined{@setaddresses}{}{\renewcommand{\@setaddresses}{}}
\@ifundefined{bibliofont}{}{\renewcommand{\bibliofont}{\small}}
\renewcommand{\refname}{The Authorities}

% --- the colophon --------------------------------------------------------------------
% \AtlasColophon sets a last leaf naming the faces, the engine and its
% version, the sources and their revision: a reproducibility statement in
% the period's place for one. \atlasrevision and \atlassources may be \def'd
% on the command line (no shell escape) or in the preamble. A layer may
% redefine \atlas@colophon@ornament (a short rule here) and add a sentence
% through \atlas@colophon@sheet (empty here). Add \AtEndDocument{\AtlasColophon}
% to the injected preamble to use it.
\providecommand{\atlasrevision}{unrecorded}
\providecommand{\atlassources}{the author's sources}
\newcommand{\atlas@colophon@ornament}{\textcolor{rubric}{\rule{22mm}{0.3pt}}}
\newcommand{\atlas@colophon@sheet}{}
\newcommand{\atlas@luatexversion}{%
  \directlua{local v = status.luatex_version
    tex.print((v // 100) .. "." .. (v - (v // 100) * 100) .. "." .. status.luatex_revision)}}
\newcommand{\AtlasColophon}{%
  \clearpage\thispagestyle{empty}%
  \vspace*{\fill}
  \begin{center}
    \atlas@colophon@ornament\par
    \vspace{2em}
    {\small\textcolor{rubric}{\textls[130]{\textsc{Colophon.}}}}\par
    \vspace{1em}
    \begin{minipage}{0.7\linewidth}\small\centering
      This edition of the preprint was set in EB~Garamond, with
      Garamond-Math for the mathematics, by LuaTeX (\atlas@luatexversion),
      from \atlassources{} at revision \texttt{\atlasrevision}, on
      \@date. \atlas@colophon@sheet
      The propositions are numbered as the author left them. Nothing in
      the mathematics has been altered by the dress.
    \end{minipage}\par
    \vspace{2em}
    \atlas@colophon@ornament\par
  \end{center}
  \vspace*{\fill}}

\endinput
